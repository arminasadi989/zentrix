# ---------------------------------------------------------------------------
# Zentrix environment variables
# Copy this file to `.env` in the repo ROOT and fill in real values.
# `.env` is gitignored. None of these values ever reach the browser: every
# keyed request is proxied through the Express server in ./server.
# ---------------------------------------------------------------------------

# Google Gemini API key - powers chat analysis and text-to-speech.
# Obtain: https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Twelve Data API key - forex spot prices and daily time series.
# Obtain: https://twelvedata.com/pricing -> free "Basic" plan (800 req/day)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# BrsApi.ir API key - Iranian free-market currency, gold ounce/coin, TSE data.
# Obtain: https://brsapi.ir/ -> register for the free tier (~1,500 req/day)
BRSAPI_KEY=your_brsapi_key_here

# --- Optional ---
# Port the API server listens on (client dev proxy expects 8787).
PORT=8787
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
